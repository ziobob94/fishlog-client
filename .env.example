VITE_API_BASE_URL=http://localhost:3001

# Google Maps: suggerimenti luogo (Places), nome/regione/provincia/comune dalle coordinate
# (Geocoding) e mappa per scegliere il punto (Maps JavaScript). NON committare la chiave.
# Google Cloud Console → crea/seleziona un progetto → attiva la fatturazione → abilita
# «Maps JavaScript API», «Places API (New)» e «Geocoding API» → Credenziali → Crea chiave API →
# restrizioni: referrer HTTP (il dominio dell'app + localhost per lo sviluppo) e solo queste 3 API.
# Senza chiave i campi luogo mostrano un avviso e restano compilabili a mano.
VITE_GOOGLE_MAPS_KEY=

# Compressione foto lato client prima dell'upload (evita 413 dal proxy)
# VITE_IMAGE_COMPRESS=true
# VITE_IMAGE_MAX_SIDE=1920
# VITE_IMAGE_QUALITY=0.8
# VITE_IMAGE_SKIP_BELOW_KB=800
