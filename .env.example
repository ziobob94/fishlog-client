VITE_API_BASE_URL=http://localhost:3001

# Mappe (MapLibre). Facoltative: senza chiave si usano provider gratuiti senza chiave
# (OpenFreeMap per la mappa, Esri per il satellite).
# Consigliata: chiave MapTiler (cloud.maptiler.com → Account → API keys), con restrizione al dominio.
VITE_MAPTILER_KEY=
# In alternativa/aggiunta: URL di stile completi di un qualsiasi provider compatibile MapLibre
VITE_MAP_STYLE_SAT=
VITE_MAP_STYLE_LIGHT=
VITE_MAP_STYLE_DARK=
